# Installer profiles target Linux x86_64 (glibc >= 2.28), Python 3.11.13.
# Recompile the matching lock with uv 0.11.7 using its generated command header.
# Existing lock pins preserve the tested stack; use --upgrade only for a reviewed update.
-e .[docking,prepare,tuning,dev,nori,tabldm,tabfm]

