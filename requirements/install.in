openmm==8.3.1
gemmi==0.6.5
optuna==4.0.0

# Seed these and their dependencies from the selected lock before building with
# --no-build-isolation. Nori requires setuptools < 81; TabLDM uses Hatchling.
setuptools>=77,<81
wheel==0.48.0
hatchling==1.32.0
